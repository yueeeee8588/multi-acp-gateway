# 8046 主网关监听地址与目录配置
BIND_ADDR=127.0.0.1:8046
DATA_DIR=data
WEB_DIR=web/dist
RUST_LOG=multi_acp_gateway=info

# ACP 伴生网关上游地址（默认对接 8048）
ACP_UPSTREAM_BASE=http://127.0.0.1:8048

# 可选：Docker 容器化部署与自动更新配置
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=1990
TRUST_PROXY=0
UPDATER_REPO=yueeeee8588/multi-acp-gateway
UPDATER_IMAGE=multi-acp-gateway:latest
# GITHUB_TOKEN=  # 可选：填写 GitHub Personal Access Token，避免触发 GitHub API 速率限制
